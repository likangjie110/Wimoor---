<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wimoor.ozon.product.mapper.OzonListingVariantMapper">

    <select id="listByDraftId" resultType="com.wimoor.ozon.product.pojo.entity.OzonListingVariant">
        select *
        from t_ozon_listing_variant
        where draft_id = #{draftId}
        order by create_time asc, id asc
    </select>
</mapper>
